# API binds only to loopback. Do not expose it to the internet.
GUARDIAN_PORT=8787
# Optional local Frigate base URL, e.g. http://127.0.0.1:5000/
GUARDIAN_FRIGATE_URL=
# Frigate authenticated endpoint: JWT bearer token (keep secret)
GUARDIAN_FRIGATE_TOKEN=
# Optional zone names separated by commas. These trigger review advisories, not threat scores.
GUARDIAN_REVIEW_ZONES=
GUARDIAN_PET_HAZARD_ZONES=
# Optional; enables POST /api/events when set (must be unpredictable)
GUARDIAN_INGEST_TOKEN=
