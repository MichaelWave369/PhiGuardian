{
  "name": "phiguardian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first environmental awareness for PhiOS",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "node server/index.mjs",
